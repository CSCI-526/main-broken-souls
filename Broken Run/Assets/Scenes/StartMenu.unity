  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "\u201CUh-oh\u2026 the blocks are alive! Controls flip, gravity goes nuts\u2014stay
    on your toes!\u201D\n\n\u201CLeap over doom! Hit UP or W and defy death itself!\u201D\n\n\u201CSlide
    like a shadow! Press DOWN or S to sneak under traps!\u201D\n\n\u201CThe Killer
    is coming\u2026 RUN, sprint, escape!\u201D\n\n\u201CCalm? Who said that? Time
    your moves perfectly or face the consequences!\u201D\n\n\u201CFail? Laugh it
    off! Each mistake makes you deadlier!\u201D\n\n\u201CToo close to the Killer?
    Big mistake\u2026 keep your distance!\u201D\n\n\u201CShield ready? Use it wisely\u2014it\u2019s
    your one-time magical armor!"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
  m_sharedMaterial: {fileID: 2180264, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
